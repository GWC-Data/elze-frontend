# Copy to .env before running `npm run dev`.

# Where the dev server proxies /api requests. Point this at the backend when it
# runs on another port or host (a container, a colleague's machine, staging).
#
# Required by `npm run dev`, which fails with a clear message without it.
# `npm run build` does not need it: the app calls relative /api paths, so the
# production bundle never contains a backend URL.
BACKEND_URL=http://localhost:8080

# ---------------------------------------------------------------- context layer

# Where the Context Layer Builder's API lives.
#
# Leave it blank or unset and the module calls relative `/api` paths — the
# Express backend, same origin, through the app's authenticated client. That is
# correct for every supported deployment today, so there is normally nothing to
# set here.
#
# Set it to an absolute origin (https://context.example.com) to point the whole
# seven-step workflow at a separate service. In that mode the app's access token
# is deliberately NOT attached, because it is not valid there and sending it to
# another origin would be leaking it — configure that service's own auth in
# src/modules/context-layer/api/client.ts.
VITE_CONTEXT_API_URL=

# ------------------------------------------------------------ analyst agents


# The ADK Agent Runtime API (elze_data_exploration_agent/adk_agents/api), used by
# the Data Analyst chat. Defaults to http://127.0.0.1:7070 when unset, which is
# only correct for local development.
VITE_ADK_API_BASE_URL=

# Optional API key sent as X-API-Key to the ADK Agent Runtime API. Matches that
# service's ADK_API_AUTH_TOKEN. Leave blank if it does not enforce one.
# LOCAL `npm run dev` ONLY: every VITE_* value is inlined into the JavaScript
# bundle, so anything set here is readable by anyone who loads the page. The
# Docker / Cloud Run image never takes it - nginx injects the key server-side
# from ADK_API_KEY instead (see frontend/nginx.conf).
VITE_ADK_API_KEY=

# ------------------------------------------------------------ agent library

# The Agent Library backend (the "Agents" screen: custom agents with a role,
# instructions, published contexts as knowledge, and a schedule).
#
# Leave blank and agents are kept in this browser's localStorage only - usable,
# but not shared and no schedule ever runs. Set an absolute origin (e.g.
# http://localhost:8400) and the same screen calls that service instead; the REST
# contract it must implement is at the top of src/api/agentLibrary.api.ts.
# Reached directly from the browser, so its CORS allow-list must include this
# app's origin. Vite inlines it: restart `npm run dev` / rebuild after changing.
VITE_AGENT_LIBRARY_API_URL=
